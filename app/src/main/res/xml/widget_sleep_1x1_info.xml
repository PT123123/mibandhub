<?xml version="1.0" encoding="utf-8"?>
<!-- 1×1 睡眠时长控件的元数据。
     minWidth/minHeight 给 Android 12 之前的桌面定初始尺寸（70dp×n−30dp 的格子公式）；
     targetCellWidth/Height 给 12+ 的桌面（澎湃OS 走这边），声明成 1×1 格。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_sleep_1x1"
    android:previewLayout="@layout/widget_sleep_1x1"
    android:description="@string/widget_sleep_desc"
    tools:targetApi="s" />
