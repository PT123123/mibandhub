<?xml version="1.0" encoding="utf-8"?>
<!-- 「昨晚睡眠」自适应控件（主控件）的元数据。
     2×2 起步：minWidth/minHeight 给 Android 12 之前的桌面定初始尺寸，
     targetCellWidth/Height 给 12+ 的桌面（澎湃OS 走这边）定初始 2×2 格。
     拉大后 SleepDetailWidgetProvider 按实际尺寸在 1×1 / 1×2 / 2×2 布局间切换，
     所以 resizeMode 仍然横竖都放开。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_sleep_detail_2x2"
    android:previewLayout="@layout/widget_sleep_detail_2x2"
    android:description="@string/widget_sleep_detail_desc"
    tools:targetApi="s" />
