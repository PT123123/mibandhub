<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应「昨晚睡眠」控件的 2×2 形态（也是这个控件的主形态）：时长 + 得分 +
     入睡→醒来 + 单条三段分期彩条（深睡/浅睡/眼动）+ 夜间清醒。
     彩条由 WidgetRenderer 画成位图（RemoteViews 只认 ImageView 收位图），
     颜色对齐应用内的分期配色；旁边一行文字是三个分期的分钟数。

     根布局 id 见 1×1 那份文件的说明（沿用 @android:id/background 标准 id）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/widget_detail_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_moon" />

            <TextView
                android:id="@+id/widget_detail_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="15sp"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeTextType="uniform"
                android:gravity="start"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/widget_text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_detail_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_detail_bedwake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="—"
            android:textColor="@color/widget_text_primary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_detail_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_sleep_detail_label"
            android:textColor="@color/widget_text_secondary"
            android:textSize="9sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:background="@color/widget_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="睡眠分期"
                android:textColor="@color/widget_text_secondary"
                android:textSize="9sp" />

            <ImageView
                android:id="@+id/widget_detail_stages_bar"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_weight="1"
                android:contentDescription="@null" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_detail_stages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="—"
            android:textColor="@color/widget_text_secondary"
            android:textSize="9sp" />

        <!-- 弹性空隙：把已醒行压到底部 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/widget_detail_awake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="—"
            android:textColor="@color/widget_text_secondary"
            android:textSize="9sp" />
    </LinearLayout>
</FrameLayout>
