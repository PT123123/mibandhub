<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- Android 11 及以下走旧蓝牙权限 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Android 12+ 新蓝牙权限。我们不用扫描结果推断位置，声明 neverForLocation
         可以免掉定位权限（否则系统会强制要求 ACCESS_FINE_LOCATION）。 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Android 11 及以下扫描需要定位权限 -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 健康连接（Health Connect）：从外部来源读睡眠（小米运动健康等 App 会把
         数据同步进来）。运行时通过 HealthPermission 的授权对话框申请。 -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ 的应用可见性：不声明这条，packageManager 只能看到系统白名单里的
         少数几个包，「允许转发的应用」就列不全手机上的应用。这里只问「有什么能启动的
         应用」，拿不到别的信息，比 QUERY_ALL_PACKAGES 克制。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ShouhuanApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shouhuan">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Shouhuan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 健康连接的「数据用途说明」入口 —— 接入方必须声明，否则 SDK 建连时
             直接 IllegalStateException（真机报过 incorrect health permission states）。
             Android 13- 走下面的 rationale action；14+ 走 activity-alias 的
             VIEW_PERMISSION_USAGE（permission 属性保证只有系统能拉起它）。 -->
        <activity
            android:name=".HealthRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".HealthRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".service.BandService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- 开机自启：把前台保活服务拉起来。BOOT_COMPLETED 是受保护广播，exported=true 安全。 -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 通知转发：读取手机通知并推到手环。需要用户在系统设置里授权。 -->
        <service
            android:name=".service.BandNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 桌面控件：1×1 睡眠时长 / 1×2 睡眠+心率曲线。标准 RemoteViews 小部件，
             小米澎湃OS 和联想 ZUI 的桌面都认这一种。系统投递的 APPWIDGET_UPDATE
             就够用，exported=false 即可。 -->
        <receiver
            android:name=".widget.SleepWidgetProvider"
            android:exported="false"
            android:label="@string/widget_sleep_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sleep_1x1_info" />
        </receiver>

        <receiver
            android:name=".widget.SleepHeartWidgetProvider"
            android:exported="false"
            android:label="@string/widget_sleep_hr_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sleep_hr_1x2_info" />
        </receiver>
    </application>

</manifest>
